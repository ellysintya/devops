# Gunakan base image Python karena punya web server bawaan
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Copy semua file ke dalam container
COPY . .

# Jalankan simple HTTP server di port 8000
CMD ["python", "-m", "http.server", "8000", "--directory", ".", "--bind", "0.0.0.0"]


# Expose port 8000
EXPOSE 8000
